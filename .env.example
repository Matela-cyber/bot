# ===== MT5 Configuration =====
MT5_PATH=C:\Program Files\Pepperstone KE MetaTrader 5 Terminal\terminal64.exe
MT5_SERVER=	
MT5_LOGIN=	
MT5_PASSWORD=

# ===== Trading Settings =====
SYMBOL=EURUSD
TIMEFRAME=15m
CYCLE_INTERVAL=30

# ===== Risk (3% per trade - CONTRACT) =====
RISK_PER_TRADE=0.03
MAX_DAILY_LOSS=0.05
DRAWDOWN_LIMIT=0.50
MAX_OPEN_TRADES=4
MAX_POSITIONS_PER_PAIR=2
MAX_TOTAL_POSITIONS=5

# ===== Filters =====
MAX_SPREAD=0.0003
SPREAD_FILTER_ENABLED=true
LOW_LIQUIDITY_FILTER_ENABLED=true
LOW_LIQUIDITY_BLOCK_START_UTC=22
LOW_LIQUIDITY_BLOCK_END_UTC=2
SHOCK_FILTER_ENABLED=true
FRIDAY_CUTOFF_HOUR=17
LOCAL_TIMEZONE=Africa/Johannesburg

# ===== Database =====
DB_PATH=bot.db

# ===== Telegram =====
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Logging =====
LOG_LEVEL=INFO

# ===== Backtest Data (HistData 2005-2024) =====
BACKTEST_DATA_DIR=forex_data/final_m15
BACKTEST_RESULTS_DIR=results2
